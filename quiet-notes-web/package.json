    "web-vitals": "3.3.2",
    "workbox-precaching": "7.1.0",
    "workbox-window": "7.1.0",
    "zod": "3.23.8"
  },
  "scripts": {
    "typecheck": "tsc",
    "start": "vite",
    "start:emulated": "vite --mode emulated",
    "build": "tsc && vite build",
    "build:w": "tsc -w & vite build -w",
    "build:emulated": "tsc -w & vite build --mode emulated",
    "build:emulated:w": "tsc -w & vite build -w --mode emulated",
    "serve": "vite preview",
    "test": "vitest",
    "test:ci": "vitest",
    "unimported": "unimported",
    "script": "nodemon --config nodemon.json"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=7"
  }
}
