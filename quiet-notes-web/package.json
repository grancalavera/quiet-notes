    "@mui/system": "5.16.7",
    "@react-rxjs/core": "0.10.4",
    "@react-rxjs/utils": "0.9.5",
    "@swc/core": "1.7.11",
    "@swc/helpers": "0.5.1",
    "@types/node": "18.16.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-table": "7.7.20",
    "@typescript-eslint/parser": "5.59.8",
    "@vitejs/plugin-react": "4.3.1",
    "benny": "3.7.1",
    "clsx": "1.2.1",
    "date-fns": "2.30.0",
    "eslint": "8.42.0",
    "firebase": "9.22.1",
    "immer": "10.1.1",
    "nanoid": "4.0.2",
    "nodemon": "2.0.22",
    "normalize.css": "8.0.1",
    "quiet-notes-lib": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.1",
    "react-table": "7.8.0",
    "rxfire": "6.0.5",
    "rxjs": "7.8.1",
    "ts-node": "10.9.2",
    "typescript": "5.5.4",
    "unimported": "1.31.1",
    "vite": "4.3.9",
    "vite-plugin-pwa": "0.16.3",
