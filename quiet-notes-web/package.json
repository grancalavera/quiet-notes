{
  "name": "quiet-notes-web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "11.13.0",
    "@emotion/styled": "11.13.0",
    "@fontsource/merriweather": "5.0.13",
    "@fontsource/roboto": "5.0.14",
    "@mui/icons-material": "5.16.7",
    "@mui/lab": "5.0.0-alpha.173",
    "@mui/material": "5.16.7",
    "@mui/system": "5.16.7",
    "@react-rxjs/core": "0.10.7",
    "@react-rxjs/utils": "0.9.7",
    "@swc/core": "1.7.11",
    "@swc/helpers": "0.5.12",
    "@types/node": "22.4.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-table": "7.7.20",
    "@typescript-eslint/parser": "8.1.0",
    "@vitejs/plugin-react": "4.3.1",
    "benny": "3.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "eslint": "9.9.0",
    "firebase": "10.13.0",
    "immer": "10.1.1",
    "nanoid": "5.0.7",
    "nodemon": "3.1.4",
    "normalize.css": "8.0.1",
    "quiet-notes-lib": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.1",
    "react-table": "7.8.0",
    "rxfire": "6.0.5",
    "rxjs": "7.8.1",
    "ts-node": "10.9.2",
    "typescript": "5.5.4",
    "unimported": "1.31.1",
    "vite": "5.4.1",
    "vite-plugin-pwa": "0.20.1",
    "vitest": "2.0.5",
    "workbox-precaching": "7.1.0",
    "workbox-window": "7.1.0",
    "zod": "3.23.8"
  },
  "scripts": {
    "typecheck": "tsc",
    "start": "vite",
    "start:emulated": "vite --mode emulated",
    "build": "tsc && vite build",
    "build:w": "tsc -w & vite build -w",
    "build:emulated": "tsc -w & vite build --mode emulated",
    "build:emulated:w": "tsc -w & vite build -w --mode emulated",
    "serve": "vite preview",
    "test": "vitest",
    "test:ci": "vitest",
    "unimported": "unimported",
    "script": "nodemon --config nodemon.json"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=7"
  }
}
